# SPDX-License-Identifier: LGPL-2.1-or-later
# Shared build settings read by scripts/lib/common.sh and scripts/lib/poc_common.py.
# Format: KEY=VALUE, one per line, no quoting or expansion.
# Any key can be overridden by exporting an environment variable of the same name.

# Requested minimum macOS deployment target for new builds. If this is unset, clang
# defaults to the build machine's SDK version, and the output then refuses to
# load on any older macOS. Actual runtime compatibility requires target-device acceptance.
POC_MACOSX_DEPLOYMENT_TARGET=11.0

# Directory names produced by extracting the archives locked in configs/*.json.
POC_LLVM_MINGW_DIR=llvm-mingw-20260616-ucrt-macos-universal
POC_M4_DIR=m4-1.4.20
POC_BISON_DIR=bison-3.8.2
POC_AUTOCONF_DIR=autoconf-2.72
POC_FFMPEG_DIR=FFmpeg-9047fa1b084f76b1b4d065af2d743df1b40dfb56
POC_FREETYPE_DIR=freetype-VER-2-13-3
POC_GMP_DIR=gmp-6.3.0
POC_NETTLE_DIR=nettle-3.10.2
POC_LIBTASN1_DIR=libtasn1-4.21.0
POC_LIBUNISTRING_DIR=libunistring-1.4.2
POC_GNUTLS_DIR=gnutls-3.8.13
POC_GE_DIR=proton-ge-custom-GE-Proton11-7
POC_MEDIA_WINE_DIR=wine-46b29104e3741fe23bf5e2547196a253aab88c89
POC_BASELINE_WINE_DIR=wine-wine-11.0
POC_CROSSOVER_ARCHIVE=crossover-sources-26.3.0.tar.gz

# Vulkan driver and headers from the locked official distributions.
POC_MOLTENVK_DIR=MoltenVK
POC_VULKAN_HEADERS_DIR=Vulkan-Headers-1.4.357
