diff --git a/dlls/winemac.drv/wine_gdi_frame_diff.h b/dlls/winemac.drv/wine_gdi_frame_diff.h
new file mode 100644
--- /dev/null
+++ b/dlls/winemac.drv/wine_gdi_frame_diff.h
@@ -0,0 +1,33 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef WINE_GDI_FRAME_DIFF_H
+#define WINE_GDI_FRAME_DIFF_H
+#include "wine_gdi_upscaler.h"
+#include <string.h>
+
+/* Exact active-pixel frame comparison. Row padding has no visual meaning.
+ * Geometry is part of identity; one changed byte invalidates the frame cache,
+ * including isolated text/cursor changes that sampled hashes can overlook. */
+static inline int wgdi_frame_bounds_valid(const struct wgdi_image *image)
+{
+    size_t row;
+    if (!image || !image->pixels || !image->width || !image->height ||
+        image->width > 8192 || image->height > 8192 ||
+        image->width * image->height > 32u * 1024 * 1024) return 0;
+    row = (size_t)image->width * 4;
+    if (image->stride < row || image->buffer_bytes < row) return 0;
+    return image->height - 1 <= (image->buffer_bytes - row) / image->stride;
+}
+
+static inline int wgdi_frames_equal(const struct wgdi_image *previous, const struct wgdi_image *current)
+{
+    size_t row, y;
+    if (!wgdi_frame_bounds_valid(previous) || !wgdi_frame_bounds_valid(current) ||
+        previous->width != current->width || previous->height != current->height) return 0;
+    row = (size_t)previous->width * 4;
+    if (previous->stride == row && current->stride == row)
+        return !memcmp(previous->pixels, current->pixels, row * previous->height);
+    for (y = 0; y < previous->height; ++y)
+        if (memcmp(previous->pixels + y * previous->stride, current->pixels + y * current->stride, row)) return 0;
+    return 1;
+}
+#endif
diff --git a/dlls/winemac.drv/wine_gdi_upscale_policy.h b/dlls/winemac.drv/wine_gdi_upscale_policy.h
new file mode 100644
--- /dev/null
+++ b/dlls/winemac.drv/wine_gdi_upscale_policy.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef WINE_GDI_UPSCALE_POLICY_H
+#define WINE_GDI_UPSCALE_POLICY_H
+
+#define WGDI_STABLE_SECONDS 0.250
+struct wgdi_stability
+{
+    double changed_at;
+    int observed;
+};
+
+/* Monotonic seconds and exact frame/geometry changes determine readiness.
+ * A changed frame always starts a new quiet interval. */
+static inline double wgdi_stability_observe(struct wgdi_stability *state, int changed, double now)
+{
+    double remaining;
+    if (changed || !state->observed || now < state->changed_at)
+    {
+        state->changed_at = now;
+        state->observed = 1;
+    }
+    remaining = WGDI_STABLE_SECONDS - (now - state->changed_at);
+    return remaining > 0 ? remaining : 0;
+}
+#endif
diff --git a/dlls/winemac.drv/wine_gdi_upscaler.h b/dlls/winemac.drv/wine_gdi_upscaler.h
new file mode 100644
--- /dev/null
+++ b/dlls/winemac.drv/wine_gdi_upscaler.h
@@ -0,0 +1,56 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+#ifndef WINE_GDI_UPSCALER_H
+#define WINE_GDI_UPSCALER_H
+#include <stddef.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+#define WGDI_UPSCALER_ABI 1u
+enum wgdi_algorithm { WGDI_ANIME4K = 1, WGDI_REALCUGAN = 2 };
+
+/* Opaque sRGB BGRA8, top row first. Padding bytes belong to the caller.
+ * The caller owns all pixels; process() retains zero caller pointers. */
+struct wgdi_image
+{
+    uint8_t *pixels;
+    size_t buffer_bytes;
+    size_t stride;
+    uint32_t width, height;
+};
+
+struct wgdi_options
+{
+    uint32_t size;
+    uint32_t algorithm;
+    const char *resource_directory;
+    uint32_t cpu_threads;
+};
+
+/* A context is confined to one worker. Every function catches C++ exceptions.
+ * create/process report errors through a caller-owned, NUL-terminated buffer.
+ * process returns 0 on success and -1 on failure, preserving Wine's fallback. */
+struct wgdi_upscaler_api
+{
+    uint32_t abi_version;
+    uint32_t size;
+    void *(*create)(const struct wgdi_options *, char *error, size_t error_size);
+    int (*process)(void *, const struct wgdi_image *, struct wgdi_image *, char *, size_t);
+    void (*destroy)(void *);
+};
+
+const struct wgdi_upscaler_api *wgdi_upscaler_get_api(uint32_t abi_version);
+
+typedef int (*wgdi_upscaler_process_regions_fn)(void *context,
+    const struct wgdi_image *input, struct wgdi_image *output,
+    const uint32_t *selection, size_t selection_count, char *error, size_t error_size);
+int wgdi_upscaler_process_regions(void *context, const struct wgdi_image *input,
+    struct wgdi_image *output, const uint32_t *selection, size_t selection_count,
+    char *error, size_t error_size);
+
+#ifdef __cplusplus
+}
+#endif
+#endif
