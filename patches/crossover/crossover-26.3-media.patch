+
+static HRESULT rsx_create(REFIID iid, void **out)
+{
+    struct rsx_object *object;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    if (!(object->shared = rsx_shared_acquire()))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+
+    object->lpVtbl = (void *)&rsx_vtbl;
+    object->ref = 1;
+
+    hr = IUnknown_QueryInterface((IUnknown *)&object->lpVtbl, iid, out);
+    IUnknown_Release((IUnknown *)&object->lpVtbl);
+    return hr;
+}
+
+static HRESULT WINAPI factory_QueryInterface(IClassFactory *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (!out) return E_POINTER;
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IClassFactory))
+    {
+        *out = iface;
+        IClassFactory_AddRef(iface);
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef(IClassFactory *iface)
+{
