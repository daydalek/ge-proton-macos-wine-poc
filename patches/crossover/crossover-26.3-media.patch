+static const GUID *get_dmo_subtype(const GUID *subtype)
+{
+    if (IsEqualGUID(subtype, &MFVideoFormat_RGB8))
+        return &MEDIASUBTYPE_RGB8;
+    else if (IsEqualGUID(subtype, &MFVideoFormat_RGB555))
+        return &MEDIASUBTYPE_RGB555;
+    else if (IsEqualGUID(subtype, &MFVideoFormat_RGB565))
+        return &MEDIASUBTYPE_RGB565;
+    else if (IsEqualGUID(subtype, &MFVideoFormat_RGB24))
+        return &MEDIASUBTYPE_RGB24;
+    else if (IsEqualGUID(subtype, &MFVideoFormat_ARGB32))
+        return &MEDIASUBTYPE_ARGB32;
+    else if (IsEqualGUID(subtype, &MFVideoFormat_RGB32))
+        return &MEDIASUBTYPE_RGB32;
+    else
+        return subtype;
+}
+
+static BOOL is_dmo_rgb_subtype(const GUID *subtype)
+{
+    return IsEqualGUID(subtype, &MEDIASUBTYPE_RGB8)
+            || IsEqualGUID(subtype, &MEDIASUBTYPE_RGB555)
+            || IsEqualGUID(subtype, &MEDIASUBTYPE_RGB565)
+            || IsEqualGUID(subtype, &MEDIASUBTYPE_RGB24)
+            || IsEqualGUID(subtype, &MEDIASUBTYPE_RGB32)
+            || IsEqualGUID(subtype, &MEDIASUBTYPE_ARGB32);
+}
+
+static void flip_bottom_up_rgb_rows(BYTE *data, DWORD size, const DMO_MEDIA_TYPE *type)
+{
+    const VIDEOINFOHEADER *info;
+    LONG width, height, stride;
+    BYTE *tmp;
+
+    if (!type->pbFormat || type->cbFormat < sizeof(*info) || !is_dmo_rgb_subtype(&type->subtype))
+        return;
+
+    info = (const VIDEOINFOHEADER *)type->pbFormat;
+    if (info->bmiHeader.biHeight <= 0)
+        return;
+
+    width = info->bmiHeader.biWidth;
+    height = info->bmiHeader.biHeight;
+    stride = ((width * info->bmiHeader.biBitCount + 31) / 32) * 4;
+    if (!width || height <= 1 || !stride || size < stride * height)
+        return;
+
+    if (!(tmp = malloc(stride)))
+        return;
+
+    for (LONG y = 0; y < height / 2; ++y)
+    {
+        BYTE *top = data + y * stride;
+        BYTE *bottom = data + (height - y - 1) * stride;
+
+        memcpy(tmp, top, stride);
+        memcpy(top, bottom, stride);
+        memcpy(bottom, tmp, stride);
+    }
+
+    free(tmp);
+}
+
+static void fill_32bit_alpha_bytes(BYTE *data, DWORD size)
+{
+    /* Texture renderers commonly treat the high RGB32 byte as alpha. */
+    for (DWORD i = 3; i < size; i += 4)
+        data[i] = 0xff;
+}
+
+static void fill_32bit_alpha(BYTE *data, DWORD size, const DMO_MEDIA_TYPE *type)
+{
+    const VIDEOINFOHEADER *info;
+
+    if (!type->pbFormat || type->cbFormat < sizeof(*info)
+            || (!IsEqualGUID(&type->subtype, &MEDIASUBTYPE_RGB32)
+                    && !IsEqualGUID(&type->subtype, &MEDIASUBTYPE_ARGB32)))
+        return;
+
+    info = (const VIDEOINFOHEADER *)type->pbFormat;
+    if (info->bmiHeader.biBitCount != 32 || info->bmiHeader.biCompression != BI_RGB)
+        return;
+
+    fill_32bit_alpha_bytes(data, size);
+}
+
+static REFERENCE_TIME dmo_output_sample_duration(const DMO_MEDIA_TYPE *type)
+{
+    if (IsEqualGUID(&type->formattype, &FORMAT_VideoInfo)
+            && type->pbFormat && type->cbFormat >= sizeof(VIDEOINFOHEADER))
+    {
+        const VIDEOINFOHEADER *info = (const VIDEOINFOHEADER *)type->pbFormat;
+
+        if (info->AvgTimePerFrame)
+            return info->AvgTimePerFrame;
+    }
+    else if (IsEqualGUID(&type->formattype, &FORMAT_VideoInfo2)
+            && type->pbFormat && type->cbFormat >= sizeof(VIDEOINFOHEADER2))
+    {
+        const VIDEOINFOHEADER2 *info = (const VIDEOINFOHEADER2 *)type->pbFormat;
+
+        if (info->AvgTimePerFrame)
+            return info->AvgTimePerFrame;
+    }
+
+    return 333667;
+}
