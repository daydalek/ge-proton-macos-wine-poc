+static HRESULT WINAPI transform_ProcessMessage(IMFTransform *iface, MFT_MESSAGE_TYPE message, ULONG_PTR param)
+{
+    struct video_decoder *decoder = impl_from_IMFTransform(iface);
+    IUnknown *d3d9_manager;
+    HRESULT hr;
+
+    TRACE("iface %p, message %#x, param %Ix.\n", iface, message, param);
+
+    switch (message)
+    {
+    case MFT_MESSAGE_SET_D3D_MANAGER:
+        if (FAILED(hr = IMFVideoSampleAllocatorEx_SetDirectXManager(decoder->allocator, (IUnknown *)param)))
+            return hr;
+
+        uninit_allocator(decoder);
+        decoder->output_info.dwFlags |= MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES;
+        decoder->output_info.dwFlags &= ~MFT_OUTPUT_STREAM_PROVIDES_SAMPLES;
+        if (param)
+        {
+            if (SUCCEEDED(IUnknown_QueryInterface((IUnknown *)param, &IID_IDirect3DDeviceManager9,
+                    (void **)&d3d9_manager)))
+            {
+                IUnknown_Release(d3d9_manager);
+                decoder->output_info.dwFlags &= ~MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES;
+            }
+            else
+            {
+                decoder->output_info.dwFlags |= MFT_OUTPUT_STREAM_PROVIDES_SAMPLES;
+            }
+        }
+        return S_OK;
+
+    case MFT_MESSAGE_COMMAND_DRAIN:
+        if (!decoder->winedmo_transform.handle) return MF_E_TRANSFORM_TYPE_NOT_SET;
+        return winedmo_transform_drain(decoder->winedmo_transform) ? E_FAIL : S_OK;
+
+    case MFT_MESSAGE_COMMAND_FLUSH:
+        if (!decoder->winedmo_transform.handle) return MF_E_TRANSFORM_TYPE_NOT_SET;
+        decoder->sample_time = -1;
+        decoder->last_output_pts = INT64_MIN;
+        decoder->observed_output_duration = 0;
+        return winedmo_transform_flush(decoder->winedmo_transform) ? E_FAIL : S_OK;
+
+    case MFT_MESSAGE_NOTIFY_START_OF_STREAM:
+        decoder->sample_time = -1;
+        decoder->last_output_pts = INT64_MIN;
+        decoder->observed_output_duration = 0;
+        return S_OK;
+
+    default:
+        FIXME("Ignoring message %#x.\n", message);
+        return S_OK;
+    }
+}
