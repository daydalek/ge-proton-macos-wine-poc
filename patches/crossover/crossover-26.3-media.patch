+    if (!status)
+        return E_INVALIDARG;
+
+    if (transform->is_shut_down)
+        *status = MFSHUTDOWN_COMPLETED;
+    else
+        hr = MF_E_INVALIDREQUEST;
+
+    return hr;
+}
