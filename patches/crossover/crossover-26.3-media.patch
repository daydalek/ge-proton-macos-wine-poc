-        IPin_Disconnect(&pin->pin.pin.IPin_iface);
-    }
-
-    pin->flushing_cs.DebugInfo->Spare[0] = 0;
-    DeleteCriticalSection(&pin->flushing_cs);
-
-    strmbase_seeking_cleanup(&pin->seek);
-    strmbase_source_cleanup(&pin->pin);
-    free(pin);
