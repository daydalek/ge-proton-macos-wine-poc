+        if (!(stream = get_stream_by_output_number(reader, output_num))
+                || !IsEqualGUID(&stream->major_type, &MFMediaType_Video))
+        {
+            LeaveCriticalSection(&reader->cs);
+            return E_INVALIDARG;
