-static HRESULT parser_sink_connect(struct strmbase_sink *iface, IPin *peer, const AM_MEDIA_TYPE *pmt)
-{
-    struct parser *filter = impl_from_strmbase_sink(iface);
-    LONGLONG file_size, unused;
-    HRESULT hr = S_OK;
-    unsigned int i;
-
-    filter->reader = NULL;
