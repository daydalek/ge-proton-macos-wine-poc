+        case WINEDMO_VIDEO_FORMAT_BGR:
+        case WINEDMO_VIDEO_FORMAT_RGB15:
+        case WINEDMO_VIDEO_FORMAT_RGB16:
+        case WINEDMO_VIDEO_FORMAT_RGBA:
+            return true;
+
+        default:
+            break;
+    }
+
+    return false;
+}
