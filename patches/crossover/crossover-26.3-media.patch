+#ifndef __WINE_WINEDMO_MEDIA_FORMAT_H
+#define __WINE_WINEDMO_MEDIA_FORMAT_H
+
+#include <stdint.h>
+#include "windef.h"
+#include "winternl.h"
+#include "wtypes.h"
+#include "mmreg.h"
