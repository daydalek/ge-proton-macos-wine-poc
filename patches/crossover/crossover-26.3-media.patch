+static HRESULT WINAPI transform_ProcessInput(IMFTransform *iface, DWORD id, IMFSample *sample, DWORD flags)
+{
+    struct video_decoder *decoder = impl_from_IMFTransform(iface);
+    IMFMediaBuffer *buffer;
+    LONGLONG time, dts, duration;
+    UINT64 decode_timestamp;
+    BYTE *data;
+    DWORD size, push_flags = 0;
+    UINT32 value;
+    NTSTATUS status;
+    HRESULT hr;
+
+    TRACE("iface %p, id %#lx, sample %p, flags %#lx.\n", iface, id, sample, flags);
+
+    if (!decoder->winedmo_transform.handle)
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+
+    if (decoder->sample_time == -1 && FAILED(IMFSample_GetSampleTime(sample, (LONGLONG *)&decoder->sample_time)))
+        decoder->sample_time = 0;
+
+    if (!decoder->previous_stride)
+        set_previous_stride(decoder);
+
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer)))
+        return hr;
+    if (FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, &size)))
+    {
+        IMFMediaBuffer_Release(buffer);
+        return hr;
+    }
+
+    if (FAILED(IMFSample_GetSampleTime(sample, &time))) time = INT64_MIN;
+    if (SUCCEEDED(IMFSample_GetUINT64(sample, &MFSampleExtension_DecodeTimestamp, &decode_timestamp)))
+        dts = decode_timestamp;
+    else
+        dts = INT64_MIN;
+    if (FAILED(IMFSample_GetSampleDuration(sample, &duration))) duration = INT64_MIN;
+    if (SUCCEEDED(IMFSample_GetUINT32(sample, &MFSampleExtension_CleanPoint, &value)) && value)
+        push_flags |= WINEDMO_SAMPLE_FLAG_SYNC_POINT;
+    if (SUCCEEDED(IMFSample_GetUINT32(sample, &MFSampleExtension_Discontinuity, &value)) && value)
+        push_flags |= WINEDMO_SAMPLE_FLAG_DISCONTINUITY;
+
+    if (time != INT64_MIN && decoder->sample_time != -1 && time + 2000000 < decoder->sample_time)
+    {
+        TRACE("Resetting decoder timeline on backward input timestamp %s -> %s.\n",
+                wine_dbgstr_longlong(decoder->sample_time), wine_dbgstr_longlong(time));
+        decoder->sample_time = -1;
+        winedmo_transform_flush(decoder->winedmo_transform);
+        push_flags |= WINEDMO_SAMPLE_FLAG_DISCONTINUITY;
+    }
+
+    status = winedmo_transform_push_input(decoder->winedmo_transform, data, size, time, dts, duration, push_flags);
+    IMFMediaBuffer_Unlock(buffer);
+    IMFMediaBuffer_Release(buffer);
+
+    if (status == STATUS_DEVICE_BUSY) return MF_E_NOTACCEPTING;
+    return status ? E_FAIL : S_OK;
+}
+
+static void video_decoder_copy_output_sample_metadata(IMFSample *dst_sample, IMFSample *src_sample)
+{
+    LONGLONG value;
+    UINT64 value64;
+    UINT32 value32;
+
+    if (SUCCEEDED(IMFSample_GetSampleTime(src_sample, &value)))
+        IMFSample_SetSampleTime(dst_sample, value);
+    if (SUCCEEDED(IMFSample_GetSampleDuration(src_sample, &value)))
+        IMFSample_SetSampleDuration(dst_sample, value);
+    if (SUCCEEDED(IMFSample_GetUINT64(src_sample, &MFSampleExtension_DecodeTimestamp, &value64)))
+        IMFSample_SetUINT64(dst_sample, &MFSampleExtension_DecodeTimestamp, value64);
+    if (SUCCEEDED(IMFSample_GetUINT32(src_sample, &MFSampleExtension_CleanPoint, &value32)))
+        IMFSample_SetUINT32(dst_sample, &MFSampleExtension_CleanPoint, value32);
+    if (SUCCEEDED(IMFSample_GetUINT32(src_sample, &MFSampleExtension_Discontinuity, &value32)))
+        IMFSample_SetUINT32(dst_sample, &MFSampleExtension_Discontinuity, value32);
+}
+
+static HRESULT output_sample(struct video_decoder *decoder, IMFSample **out, IMFSample *src_sample)
+{
+    MFT_OUTPUT_DATA_BUFFER output = {0};
+    IMFSample *sample;
+    DWORD status;
+    HRESULT hr;
+
+    if (FAILED(hr = init_allocator(decoder)))
+    {
+        ERR("Failed to initialize allocator, hr %#lx.\n", hr);
+        return hr;
+    }
+    if (FAILED(hr = IMFVideoSampleAllocatorEx_AllocateSample(decoder->allocator, &sample)))
+        return hr;
+
+    if (FAILED(hr = IMFTransform_ProcessInput(decoder->copier, 0, src_sample, 0)))
+    {
+        IMFSample_Release(sample);
+        return hr;
+    }
+    output.pSample = sample;
+    if (FAILED(hr = IMFTransform_ProcessOutput(decoder->copier, 0, 1, &output, &status)))
+    {
+        IMFSample_Release(sample);
+        return hr;
+    }
+    video_decoder_copy_output_sample_metadata(sample, src_sample);
+    *out = sample;
+    return S_OK;
+}
+
+static HRESULT copy_output_sample(struct video_decoder *decoder, IMFSample *dst_sample, IMFSample *src_sample)
+{
+    MFT_OUTPUT_DATA_BUFFER output = {0};
+    DWORD status;
+    HRESULT hr;
+
+    if (FAILED(hr = init_allocator(decoder)))
+    {
+        ERR("Failed to initialize allocator, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    if (FAILED(hr = IMFTransform_ProcessInput(decoder->copier, 0, src_sample, 0)))
+        return hr;
+
+    output.pSample = dst_sample;
+    if (FAILED(hr = IMFTransform_ProcessOutput(decoder->copier, 0, 1, &output, &status)))
+        return hr;
+
+    video_decoder_copy_output_sample_metadata(dst_sample, src_sample);
+
+    return S_OK;
+}
+
+static HRESULT create_decoder_output_sample(struct video_decoder *decoder, const GUID *subtype, UINT64 frame_size,
+        UINT32 sample_size, IMFSample **out)
+{
+    UINT32 height = (UINT32)frame_size, stride, width = frame_size >> 32;
+    BOOL use_compact_buffer = IsEqualGUID(subtype, &MFVideoFormat_NV12) && (width % 16 || height % 16);
+    IMFMediaBuffer *buffer = NULL;
+    DWORD size;
+    HRESULT hr;
+
+    if (decoder->temp_buffer)
+    {
+        if (FAILED(IMFMediaBuffer_GetMaxLength(decoder->temp_buffer, &size)) || size < sample_size)
+        {
+            IMFMediaBuffer_Release(decoder->temp_buffer);
+            decoder->temp_buffer = NULL;
+        }
+    }
+    if (!decoder->temp_buffer)
+    {
+        if (use_compact_buffer)
+            hr = MFCreateMemoryBuffer(sample_size, &decoder->temp_buffer);
+        else
+            hr = MFCreate2DMediaBuffer(width, height, subtype->Data1,
+                    SUCCEEDED(IMFMediaType_GetUINT32(decoder->output_type, &MF_MT_DEFAULT_STRIDE, &stride))
+                    && (INT32)stride < 0, &decoder->temp_buffer);
+        if (FAILED(hr) && FAILED(hr = MFCreateMemoryBuffer(sample_size, &decoder->temp_buffer)))
+            return hr;
+    }
+
+    if (FAILED(hr = MFCreateSample(out)))
+        return hr;
+    if (FAILED(hr = IMFSample_AddBuffer(*out, decoder->temp_buffer)))
+    {
+        IMFSample_Release(*out);
+        *out = NULL;
+        return hr;
+    }
+
+    if (SUCCEEDED(IMFSample_ConvertToContiguousBuffer(*out, &buffer)))
+    {
+        IMFMediaBuffer_SetCurrentLength(buffer, 0);
+        IMFMediaBuffer_Release(buffer);
+    }
+
+    return S_OK;
+}
+
+static BOOL video_decoder_media_type_guid_changed(IMFMediaType *old_type, IMFMediaType *new_type, REFGUID key)
+{
+    GUID old_value, new_value;
+    HRESULT old_hr, new_hr;
+
+    old_hr = IMFMediaType_GetGUID(old_type, key, &old_value);
+    new_hr = IMFMediaType_GetGUID(new_type, key, &new_value);
+    return old_hr != new_hr || (SUCCEEDED(old_hr) && !IsEqualGUID(&old_value, &new_value));
+}
+
+static BOOL video_decoder_media_type_uint32_changed(IMFMediaType *old_type, IMFMediaType *new_type, REFGUID key)
+{
+    UINT32 old_value, new_value;
+    HRESULT old_hr, new_hr;
+
+    old_hr = IMFMediaType_GetUINT32(old_type, key, &old_value);
+    new_hr = IMFMediaType_GetUINT32(new_type, key, &new_value);
+    return old_hr != new_hr || (SUCCEEDED(old_hr) && old_value != new_value);
+}
+
+static BOOL video_decoder_media_type_uint64_changed(IMFMediaType *old_type, IMFMediaType *new_type, REFGUID key)
+{
+    UINT64 old_value, new_value;
+    HRESULT old_hr, new_hr;
+
+    old_hr = IMFMediaType_GetUINT64(old_type, key, &old_value);
+    new_hr = IMFMediaType_GetUINT64(new_type, key, &new_value);
+    return old_hr != new_hr || (SUCCEEDED(old_hr) && old_value != new_value);
+}
+
+static BOOL video_decoder_needs_stream_change(struct video_decoder *decoder, IMFMediaType *new_type)
+{
+    IMFMediaType *old_type = decoder->output_type;
+
+    if (!old_type)
+        return TRUE;
+
+    return video_decoder_media_type_guid_changed(old_type, new_type, &MF_MT_SUBTYPE)
+            || video_decoder_media_type_uint64_changed(old_type, new_type, &MF_MT_FRAME_SIZE)
+            || video_decoder_media_type_uint64_changed(old_type, new_type, &MF_MT_FRAME_RATE)
+            || video_decoder_media_type_uint32_changed(old_type, new_type, &MF_MT_DEFAULT_STRIDE)
+            || video_decoder_media_type_uint32_changed(old_type, new_type, &MF_MT_SAMPLE_SIZE);
+}
+
+static HRESULT handle_stream_type_change(struct video_decoder *decoder, BOOL *changed)
+{
+    union winedmo_format *format;
+    IMFMediaType *new_type = NULL;
+    UINT64 frame_size, frame_rate;
+    UINT32 sample_size;
+    LONG stride;
+    GUID major;
+    GUID subtype;
+    HRESULT hr;
+
+    *changed = FALSE;
+
+    if (FAILED(hr = winedmo_transform_get_output_format(decoder->winedmo_transform, &major, &format)))
+    {
+        WARN("Failed to get transform output format, hr %#lx\n", hr);
+        return hr;
+    }
+
+    subtype = format->video.guidFormat;
+    hr = MFCreateVideoMediaTypeFromSubtype(&subtype, (IMFVideoMediaType **)&new_type);
+    if (SUCCEEDED(hr) && format->video.videoInfo.dwWidth && format->video.videoInfo.dwHeight)
+    {
+        UINT32 width = format->video.videoInfo.dwWidth;
+        UINT32 height = format->video.videoInfo.dwHeight;
+        UINT64 sz;
+
+        /* Life Makeover's Beginner_pc_win10.mp4 needs codec-aligned NV12 output
+         * dimensions; the smaller visible area is carried in the aperture blobs. */
+        sz = ((UINT64)width << 32) | height;
+        IMFMediaType_SetUINT64(new_type, &MF_MT_FRAME_SIZE, sz);
+        IMFMediaType_SetBlob(new_type, &MF_MT_GEOMETRIC_APERTURE,
+                (BYTE *)&format->video.videoInfo.GeometricAperture, sizeof(format->video.videoInfo.GeometricAperture));
+        IMFMediaType_SetBlob(new_type, &MF_MT_MINIMUM_DISPLAY_APERTURE,
+                (BYTE *)&format->video.videoInfo.MinimumDisplayAperture, sizeof(format->video.videoInfo.MinimumDisplayAperture));
+        IMFMediaType_SetBlob(new_type, &MF_MT_PAN_SCAN_APERTURE,
+                (BYTE *)&format->video.videoInfo.PanScanAperture, sizeof(format->video.videoInfo.PanScanAperture));
+    }
+    free(format);
+
+    if (FAILED(hr))
+        return hr;
+
+    if (SUCCEEDED(IMFMediaType_GetUINT64(decoder->output_type, &MF_MT_FRAME_RATE, &frame_rate)))
+        IMFMediaType_SetUINT64(new_type, &MF_MT_FRAME_RATE, frame_rate);
+    if (SUCCEEDED(IMFMediaType_GetUINT64(new_type, &MF_MT_FRAME_SIZE, &frame_size)))
+    {
+        if (SUCCEEDED(MFGetStrideForBitmapInfoHeader(subtype.Data1, frame_size >> 32, &stride)))
+            IMFMediaType_SetUINT32(new_type, &MF_MT_DEFAULT_STRIDE, abs(stride));
+        if (SUCCEEDED(MFCalculateImageSize(&subtype, frame_size >> 32, frame_size, &sample_size)))
+            IMFMediaType_SetUINT32(new_type, &MF_MT_SAMPLE_SIZE, sample_size);
+    }
+
+    *changed = video_decoder_needs_stream_change(decoder, new_type);
+
+    if (!*changed)
+    {
+        IMFMediaType_Release(new_type);
+        return S_OK;
+    }
+
+    if (decoder->stream_type)
+        IMFMediaType_Release(decoder->stream_type);
+    decoder->stream_type = new_type;
+    IMFMediaType_AddRef(new_type);
+
+    if (decoder->output_type)
+        IMFMediaType_Release(decoder->output_type);
+    decoder->output_type = new_type;
+
+    if (FAILED(hr = IMFMediaType_GetUINT64(decoder->stream_type, &MF_MT_FRAME_SIZE, &frame_size)))
+        return hr;
+    if (FAILED(hr = update_output_info_size(decoder, frame_size >> 32, frame_size)))
+        return hr;
+    uninit_allocator(decoder);
+
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_ProcessOutput(IMFTransform *iface, DWORD flags, DWORD count,
+        MFT_OUTPUT_DATA_BUFFER *samples, DWORD *status)
+{
+    struct video_decoder *decoder = impl_from_IMFTransform(iface);
+    UINT32 sample_size;
+    LONGLONG duration, sample_duration;
+    IMFSample *sample, *provided_sample = NULL, *decode_sample = NULL;
+    IMFMediaBuffer *buffer = NULL;
+    UINT64 frame_size, frame_rate;
+    GUID subtype;
+    BYTE *data;
+    UINT32 out_size;
+    INT64 pts, dur;
+    INT64 output_pts, output_dur;
+    DWORD out_flags;
+    NTSTATUS ntstatus;
+    HRESULT hr;
+
+    TRACE("iface %p, flags %#lx, count %lu, samples %p, status %p.\n", iface, flags, count, samples, status);
+
+    if (count != 1)
+        return E_INVALIDARG;
+
+    if (!decoder->winedmo_transform.handle)
+        return MF_E_TRANSFORM_TYPE_NOT_SET;
+
+    *status = samples->dwStatus = 0;
+    if (!(sample = samples->pSample) && !(decoder->output_info.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES))
+        return E_INVALIDARG;
+    provided_sample = sample;
+
+    if (FAILED(hr = IMFMediaType_GetGUID(decoder->output_type, &MF_MT_SUBTYPE, &subtype)))
+        return hr;
+    if (FAILED(hr = IMFMediaType_GetUINT64(decoder->output_type, &MF_MT_FRAME_SIZE, &frame_size)))
+        return hr;
+    if (FAILED(hr = MFCalculateImageSize(&subtype, frame_size >> 32, (UINT32)frame_size, &sample_size)))
+        return hr;
+
+    if (decoder->output_info.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES)
+    {
+        if (FAILED(hr = create_decoder_output_sample(decoder, &subtype, frame_size, sample_size, &sample)))
+            return hr;
+        decode_sample = sample;
+    }
+
+    if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer)) ||
+            FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, NULL)))
+    {
+        if (decode_sample || FAILED(hr = create_decoder_output_sample(decoder, &subtype, frame_size, sample_size, &decode_sample)))
+            goto done;
+
+        sample = decode_sample;
+        if (FAILED(hr = IMFSample_ConvertToContiguousBuffer(sample, &buffer)) ||
+                FAILED(hr = IMFMediaBuffer_Lock(buffer, &data, NULL, NULL)))
+            goto done;
+    }
+
+    out_size = sample_size;
+    ntstatus = winedmo_transform_get_output(decoder->winedmo_transform, data, &out_size,
+            &pts, &dur, &out_flags);
+    if (!ntstatus && !(out_flags & WINEDMO_SAMPLE_FLAG_FORMAT_CHANGED)
+            && (IsEqualGUID(&subtype, &MFVideoFormat_RGB32) || IsEqualGUID(&subtype, &MFVideoFormat_ARGB32)))
+        fill_32bit_alpha_bytes(data, out_size);
+    IMFMediaBuffer_Unlock(buffer);
+
+    if (!ntstatus && (out_flags & WINEDMO_SAMPLE_FLAG_FORMAT_CHANGED))
+    {
+        BOOL type_changed;
+
+        if (FAILED(hr = handle_stream_type_change(decoder, &type_changed)))
+            goto done;
+        if (type_changed)
+        {
+            samples[0].dwStatus |= MFT_OUTPUT_DATA_BUFFER_FORMAT_CHANGE;
+            *status |= MFT_OUTPUT_DATA_BUFFER_FORMAT_CHANGE;
+            hr = MF_E_TRANSFORM_STREAM_CHANGE;
+            goto done;
+        }
+
+        TRACE("Ignoring no-op decoder output format change.\n");
+        samples->dwStatus = MFT_OUTPUT_DATA_BUFFER_NO_SAMPLE;
+        hr = MF_E_TRANSFORM_NEED_MORE_INPUT;
+        goto done;
+    }
+
+    if (!ntstatus)
+    {
+        IMFMediaBuffer_SetCurrentLength(buffer, out_size);
+
+        if (FAILED(IMFMediaType_GetUINT64(decoder->input_type, &MF_MT_FRAME_RATE, &frame_rate)))
+            frame_rate = (UINT64)30000 << 32 | 1001;
+        duration = MulDiv(10000000, (UINT32)frame_rate, frame_rate >> 32);
+        output_dur = dur > 0 ? dur : duration;
+        output_pts = clamp_runaway_video_pts(decoder, pts, output_dur);
+
+        {
+            /* This is the IMFTransform output path. The DMO path below handles its own
+             * timestamps separately, so checking IMediaObject_iface here is wrong. */
+            if (output_pts != INT64_MIN)
+            {
+                IMFSample_SetSampleTime(sample, output_pts);
+                video_decoder_update_observed_duration(decoder, output_pts, &output_dur);
+                if (output_dur != INT64_MIN
+                        && (FAILED(IMFSample_GetSampleDuration(sample, &sample_duration))
+                        || !sample_duration || sample_duration < output_dur))
+                    IMFSample_SetSampleDuration(sample, output_dur);
+                decoder->sample_time = output_pts + output_dur;
+            }
+            else
+            {
+                IMFSample_SetSampleTime(sample, decoder->sample_time);
+                IMFSample_SetSampleDuration(sample, duration);
+                decoder->sample_time += duration;
+            }
+        }
+
+        if (out_flags & WINEDMO_SAMPLE_FLAG_INCOMPLETE)
+            samples->dwStatus |= MFT_OUTPUT_DATA_BUFFER_INCOMPLETE;
+        if (decode_sample && provided_sample && FAILED(hr = copy_output_sample(decoder, provided_sample, decode_sample)))
+            goto done;
+        hr = S_OK;
+    }
+    else if (ntstatus == STATUS_MORE_PROCESSING_REQUIRED)
+    {
+        samples->dwStatus = MFT_OUTPUT_DATA_BUFFER_NO_SAMPLE;
+        hr = MF_E_TRANSFORM_NEED_MORE_INPUT;
+    }
+    else if (ntstatus == STATUS_END_OF_FILE)
+    {
+        samples->dwStatus = MFT_OUTPUT_DATA_BUFFER_NO_SAMPLE;
+        hr = MF_E_TRANSFORM_NEED_MORE_INPUT;
+    }
+    else
+    {
+        samples->dwStatus = MFT_OUTPUT_DATA_BUFFER_NO_SAMPLE;
+        hr = E_FAIL;
+    }
+
+done:
+    if (buffer)
+        IMFMediaBuffer_Release(buffer);
+
+    if (decoder->output_info.dwFlags & MFT_OUTPUT_STREAM_PROVIDES_SAMPLES)
+    {
+        if (hr == S_OK && FAILED(hr = output_sample(decoder, &samples->pSample, sample)))
+            ERR("Failed to output sample, hr %#lx.\n", hr);
+    }
+    if (decode_sample)
+        IMFSample_Release(decode_sample);
+
+    return hr;
+}
