 static HRESULT WINAPI WMPSettings_get_volume(IWMPSettings *iface, LONG *p)
 {
     WindowsMediaPlayer *This = impl_from_IWMPSettings(iface);
     TRACE("(%p)->(%p)\n", This, p);
     if (!p)
         return E_POINTER;
     *p = This->volume;
     return S_OK;
 }
 
 static HRESULT WINAPI WMPSettings_put_volume(IWMPSettings *iface, LONG v)
 {
     WindowsMediaPlayer *This = impl_from_IWMPSettings(iface);
     TRACE("(%p)->(%ld)\n", This, v);
+    if (v < 0 || v > 100)
+        return E_INVALIDARG;
     This->volume = v;
     if (!This->filter_graph)
         return S_OK;
 
-    /* IBasicAudio -   [-10000, 0], wmp - [0, 100] */
-    v = 10000 * v / 100 - 10000;
+    /* IBasicAudio uses hundredths of a decibel; WMP exposes a percentage.
+     * Convert the amplitude ratio logarithmically so low settings remain audible. */
+    v = v ? 2000.0 * log10(v / 100.0) : -10000;
     if (!This->basic_audio)
         return S_FALSE;
 
     return IBasicAudio_put_Volume(This->basic_audio, v);
 }
 
