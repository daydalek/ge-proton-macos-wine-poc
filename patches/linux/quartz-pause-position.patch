Subject: quartz: preserve graph position across no-position requests and pauses
License: LGPL-2.1-or-later

Keep the graph clock snapshot when upstream SetPositions returns a seek origin
for a NoPositioning request. Account for the current Run interval once when
pausing, while retaining the cumulative stream offset used by filter Run.
This preserves the existing filter forwarding and return-value behavior.

--- a/dlls/quartz/filtergraph.c
+++ b/dlls/quartz/filtergraph.c
@@ -2802,7 +2802,9 @@
                 *current_ptr = current;
             if (stop_ptr && (stop_flags & AM_SEEKING_ReturnTime))
                 *stop_ptr = stop;
-            graph->current_pos = current;
+            /* Keep the graph clock snapshot for no-position requests. */
+            if ((current_flags & 0x7) != AM_SEEKING_NoPositioning)
+                graph->current_pos = current;
         }
         else if (filter_hr != E_NOTIMPL)
         {
@@ -5476,7 +5478,8 @@
         REFERENCE_TIME time;
         IReferenceClock_GetTime(graph->refClock, &time);
         graph->stream_elapsed += time - graph->stream_start;
-        graph->current_pos += graph->stream_elapsed;
+        /* stream_elapsed includes prior Run intervals; add this interval once. */
+        graph->current_pos += time - graph->stream_start;
     }
 
     LIST_FOR_EACH_ENTRY(filter, &graph->filters, struct filter, entry)
